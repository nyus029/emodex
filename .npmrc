# @mastra/core@1.x bundles @ai-sdk/ui-utils@1.2.11 which declares a peer
# dependency on zod@^3.23.8 (Zod v3), while this project uses zod@^4.x.
# Mastra has not yet updated this transitive dependency to support Zod v4
# (confirmed up through @mastra/core@1.5.0).
#
# legacy-peer-deps skips peer-dependency validation, equivalent to running
# `npm install --legacy-peer-deps` on every invocation.
legacy-peer-deps=true
