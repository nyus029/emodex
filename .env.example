# Example database connection for local development (Docker compose defaults).
DATABASE_URL="mysql://emodex:emodex@localhost:3307/emodex"

# Optional: enable real Mastra model streaming instead of mock fallback.
OPENAI_API_KEY=""
OPENAI_MODEL="openai/gpt-5-codex"

# Blob storage configuration
BLOB_READ_WRITE_TOKEN=""

# Auth0 configuration
AUTH0_DOMAIN=xxxxxxxxxxxx
AUTH0_CLIENT_ID=xxxxxxxxxxxx
AUTH0_CLIENT_SECRET=xxxxxxxxxxxx
AUTH0_SECRET=xxxxxxxxxxxx
APP_BASE_URL=http://localhost:3000

# Comma-separated emails allowed to bootstrap the first system administrator.
SYSTEM_ADMIN_BOOTSTRAP_EMAILS=""

# Vercel Cron secret for /api/cron/* endpoints
CRON_SECRET=""

# Mastra storage (LibSQL). For Vercel: set Turso to avoid 405 (read-only filesystem).
# - Set both TURSO_* for production: turso db show --url <db-name> && turso db tokens create <db-name>
# - Unset both: local uses file:./mastra.db; Vercel falls back to file:/tmp/mastra.db (volatile)
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""