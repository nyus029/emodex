generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  adminGroups Group[] @relation("GroupAdmin")
  systemAdministrator SystemAdministrator?
  createdSystemAdministrators SystemAdministrator[] @relation("SystemAdministratorCreatedBy")
  dividendApprovalRequests DividendApprovalRequest[] @relation("DividendApprovalRequester")
  dividendApprovals        DividendApproval[]        @relation("DividendApprover")
  pushSubscriptions        PushSubscription[]
  notificationDeliveries   NotificationDelivery[]
}

model Group {
  id          Int          @id @default(autoincrement())
  groupName   String
  adminUserId Int
  adminUser   User         @relation("GroupAdmin", fields: [adminUserId], references: [id])
  memberships Membership[]
  albums      Album[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id        Int             @id @default(autoincrement())
  userId    Int
  groupId   Int
  role      MembershipRole  @default(MEMBER)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, groupId])
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum AlbumType {
  PRIVATE
  SHARED
}

model Album {
  id                      String          @id @default(cuid())
  userId                  String
  name                    String          @unique
  rootPath                String          @unique
  albumType               AlbumType       @default(PRIVATE)
  groupId                 Int?
  group                   Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  plannedDividend         DateTime?
  createdTags             Json?
  requiredAtAlbumCreation Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  photoStorages           PhotoStorage[]
  dividendEvents          DividendEvent[]
  approvalRequests        DividendApprovalRequest[]
  emoShockEvents          EmoShockEvent[]
}

model PhotoStorage {
  id                String              @id @default(cuid())
  albumId           String
  album             Album               @relation(fields: [albumId], references: [id], onDelete: Cascade)
  name              String
  storagePath       String
  photoCount        Int
  totalSizeBytes    BigInt              @db.BigInt
  tags              Json?
  baseEmoPerPhoto   Int                 @default(100)
  compoundStartDate DateTime            @default(now())
  isCompoundActive  Boolean             @default(true)
  createdAt         DateTime            @default(now())
  photos            PhotoStoragePhoto[]
  emoSnapshots      EmoSnapshot[]
  dividendEvents    DividendEvent[]
  approvalRequests  DividendApprovalRequest[]

  @@index([albumId, createdAt])
  @@unique([albumId, name])
}

model PhotoStoragePhoto {
  id             String       @id @default(cuid())
  photoStorageId String
  photoStorage   PhotoStorage @relation(fields: [photoStorageId], references: [id], onDelete: Cascade)
  fileName       String
  blobPath       String
  blobUrl        String       @db.Text
  contentType    String?
  sizeBytes      BigInt       @db.BigInt
  createdAt      DateTime     @default(now())

  @@index([photoStorageId, createdAt])
}

model SystemAdministrator {
  id              String  @id @default(cuid())
  userId          Int     @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUserId Int?
  createdByUser   User?   @relation("SystemAdministratorCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
}

model EmoSnapshot {
  id             String       @id @default(cuid())
  photoStorageId String
  photoStorage   PhotoStorage @relation(fields: [photoStorageId], references: [id], onDelete: Cascade)
  snapshotDate   DateTime     @db.Date
  emoValue       Float
  createdAt      DateTime     @default(now())

  @@unique([photoStorageId, snapshotDate])
  @@index([photoStorageId, snapshotDate])
}

enum DividendAction {
  REINVEST
  RECEIVE
}

model DividendEvent {
  id                String                   @id @default(cuid())
  albumId           String
  album             Album                    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  photoStorageId    String
  photoStorage      PhotoStorage             @relation(fields: [photoStorageId], references: [id], onDelete: Cascade)
  action            DividendAction
  emoValueAtEvent   Float
  previousBaseEmo   Int
  newBaseEmo        Int
  executedAt        DateTime                 @default(now())
  approvalRequestId String?                  @unique
  approvalRequest   DividendApprovalRequest? @relation(fields: [approvalRequestId], references: [id])
  notificationDeliveries NotificationDelivery[]

  @@index([albumId, executedAt])
  @@index([photoStorageId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EXPIRED
}

model DividendApprovalRequest {
  id                String              @id @default(cuid())
  albumId           String
  album             Album               @relation(fields: [albumId], references: [id], onDelete: Cascade)
  photoStorageId    String
  photoStorage      PhotoStorage        @relation(fields: [photoStorageId], references: [id], onDelete: Cascade)
  requestedByUserId Int
  requestedByUser   User                @relation("DividendApprovalRequester", fields: [requestedByUserId], references: [id])
  status            ApprovalStatus      @default(PENDING)
  emoValueAtRequest Float
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  approvals         DividendApproval[]
  dividendEvent     DividendEvent?

  @@index([albumId, status])
  @@index([photoStorageId])
}

model DividendApproval {
  id                String                  @id @default(cuid())
  approvalRequestId String
  approvalRequest   DividendApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  userId            Int
  user              User                    @relation("DividendApprover", fields: [userId], references: [id])
  isApproved        Boolean                 @default(false)
  approvedAt        DateTime?
  createdAt         DateTime                @default(now())

  @@unique([approvalRequestId, userId])
  @@index([userId])
}


enum NotificationType {
  DIVIDEND_RECEIVED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  isActive  Boolean  @default(true)
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
}

model NotificationDelivery {
  id              String             @id @default(cuid())
  type            NotificationType   @default(DIVIDEND_RECEIVED)
  status          NotificationStatus @default(PENDING)
  userId          Int
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  dividendEventId String
  dividendEvent   DividendEvent      @relation(fields: [dividendEventId], references: [id], onDelete: Cascade)
  dedupeKey       String             @unique
  payload         Json
  attemptCount    Int                @default(0)
  maxAttempts     Int                @default(5)
  nextAttemptAt   DateTime           @default(now())
  lastError       String?            @db.Text
  sentAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([dividendEventId, userId])
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}

model MoodRecord {
  id                 String    @id @default(cuid())
  userId             String
  sentence           String    @db.Text
  words              Json
  recommendationText String?   @db.Text
  boostedAlbumIds    Json?
  boostedAlbumScores Json?
  createdAt          DateTime  @default(now())
  emoShockEvents     EmoShockEvent[]

  @@index([userId])
}

model EmoShockEvent {
  id           String     @id @default(cuid())
  albumId      String
  album        Album      @relation(fields: [albumId], references: [id], onDelete: Cascade)
  moodRecordId String
  moodRecord   MoodRecord @relation(fields: [moodRecordId], references: [id], onDelete: Cascade)
  shockRate    Float
  shockedAt    DateTime
  recoveryDays Int        @default(7)
  reason       String?    @db.Text
  createdAt    DateTime   @default(now())

  @@index([albumId, shockedAt])
  @@index([moodRecordId])
}
